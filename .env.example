# --- Formulieren -------------------------------------------------------------
# Waar <Form> zijn inzending naartoe POST (de CMS-origin). Leeg = same-origin (dan 404 in dev).
# dev:  http://localhost:3000      prod: https://cms.bedigital.nl
NEXT_PUBLIC_FORMS_ENDPOINT=http://localhost:3000

# --- Media -------------------------------------------------------------------
# app/media/[filename] stuurt /media/<bestand> door naar het publieke, tenant-scoped
# media-endpoint van het CMS. Beide zijn verplicht, anders 404 → gebroken afbeeldingen.
MEDIA_PUBLIC_BASE=http://localhost:3000/media
MEDIA_TENANT_SLUG=ameland-residence

# --- Tommy Booking Support ----------------------------------------------------
# De boekingsmodule (zoeken + boeken). Zonder API-key toont de site een nette placeholder
# in plaats van een lege sectie. Account/key horen bij DEZE klant.
NEXT_PUBLIC_TOMMY_ACCOUNT=AmelandResidence
# De publieke widget-key. Deze staat al in de HTML van de bestaande site (data-apikey op
# #TommyBookingSupport) — vraag hem op bij de klant of neem hem daar over.
NEXT_PUBLIC_TOMMY_APIKEY=

# --- Site ---------------------------------------------------------------------
# Alleen nodig op preview-deployments: Tommy heeft een absolute success-URL nodig. In productie
# wordt die afgeleid uit content/i18n.json → domainLocales (nl → .nl, de → .de).
# NEXT_PUBLIC_SITE_URL=https://ameland-residence-preview.vercel.app
